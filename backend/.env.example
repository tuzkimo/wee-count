# backend/.env.example
# 复制为 .env 后填入实际值。.env 不进版本控制。

# 数据库
POSTGRES_USER=wee
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wee-count
DATABASE_URL=postgres://wee:change-me@postgres:5432/wee-count?sslmode=disable

# Redis
REDIS_URL=redis:6379
REDIS_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-in-production

# 反向代理信任：仅当服务位于可信反向代理（如 Caddy）之后时设为 true，
# 否则限流按 socket peer 地址计（默认，客户端无法伪造 X-Forwarded-For 绕过）。
TRUST_PROXY=false

# AI（可选）
# AI_API_KEY 留空 = 整个 AI 功能禁用，其余 AI_* 全部无效——它是唯一开关。
AI_API_KEY=
# 任何 OpenAI 兼容的供应商都可以，改 AI_BASE_URL + AI_MODEL 即可：
#   DeepSeek   https://api.deepseek.com/v1                    （默认）
#   通义千问   https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi       https://api.moonshot.cn/v1
#   智谱 GLM   https://open.bigmodel.cn/api/paas/v4
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# 单次回复的 token 上限
AI_MAX_TOKENS=1024
# 上游调用超时，写在 http.Client 上；半死上游不会挂住 goroutine
AI_TIMEOUT=60s
# 每用户每分钟 / 每日请求数上限。两者都是**进程内存计数**：
# 多实例部署时每个实例各算一份，不是全局配额（详见 docs/SELF-HOSTING.md）。
AI_RATE_LIMIT=20
AI_DAILY_LIMIT=200

# 跨域白名单：逗号分隔、必须带 scheme、精确匹配。
# ⚠️ 设置了就**整体替换**默认值（不是追加），所以默认的两条也要一起写上。
# Tauri 壳（含安卓实机）发出的请求 Origin 是 http://tauri.localhost，这条覆盖它；
# 桌面 `npm run tauri dev` 走 Vite 开发服务器，Origin 是 http://localhost:1420。
# ⚠️ 线上换成你真实的前端来源，不要照抄下面的开发值。
CORS_ALLOWED_ORIGINS=http://tauri.localhost,http://localhost:1420

# AI 供应商需要经代理访问时填写：本地与线上**都可能**需要，只是代理地址通常不同。
# 留空 = 直连。用 AI_ 前缀的变量名，避免与宿主机自身的 HTTP_PROXY 混淆。
# 容器内的 host.docker.internal 只在 Docker Desktop（Windows/macOS）可用；
# Linux 上按实际代理地址填（如 http://172.17.0.1:7897 或网关/内网代理地址）。
# AI_HTTP_PROXY=http://host.docker.internal:7897
# AI_HTTPS_PROXY=http://host.docker.internal:7897
# AI_NO_PROXY=localhost,127.0.0.1,postgres,redis
